[Unit]
Description=Search Engine EVA Agent catalog API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/search-engine-eva-agent
EnvironmentFile=/etc/search-engine-eva-agent.env
EnvironmentFile=/etc/search-engine-eva-agent-revision.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=SEARCH_BACKEND=local
Environment=SEARCH_CATALOG_INDEX=/var/lib/search-engine-eva-agent/catalog-baseline-v1.sqlite3
Environment=SEARCH_CATALOG_ACTIVE_INDEX=/var/lib/search-engine-eva-agent/catalog-active-v2.sqlite3
Environment=SEARCH_AGENT_ARTIFACT_ROOT=/var/lib/search-engine-eva-agent/runtime
Environment=SEARCH_LOG_FORMAT=json
Environment=SEARCH_LOG_LEVEL=WARNING
Environment=SEARCH_LOG_LEVEL_API=INFO
Environment=SEARCH_LOG_LEVEL_BACKEND=WARNING
Environment=SEARCH_LOG_LEVEL_CATALOG=WARNING
Environment=SEARCH_LOG_LEVEL_CATALOG_INDEX=INFO
Environment=SEARCH_LOG_LEVEL_CATALOG_PIPELINE=WARNING
Environment=SEARCH_LOG_LEVEL_CATALOG_SERVING=INFO
Environment=SEARCH_LOG_LEVEL_AGENT_OPTIMIZATION=INFO
Environment=SEARCH_LOG_LEVEL_AGENT_EVAL=INFO
Environment=SEARCH_LOG_LEVEL_AGENT_MODEL=WARNING
Environment=SEARCH_LOG_LEVEL_AGENT_PROVIDER=WARNING
Environment=SEARCH_LOG_LEVEL_AGENT_RUNTIME=WARNING
Environment=SEARCH_LOG_LEVEL_AGENT_TOOLS=WARNING
Environment=SEARCH_LOG_LEVEL_BAD_CASE=INFO
Environment=SEARCH_LOG_LEVEL_BAD_CASE_SUPERVISOR=INFO
Environment=SEARCH_LOG_LEVEL_BAD_CASE_WORKER=INFO
Environment=SEARCH_LOG_LEVEL_DIAGNOSTIC_EXPERIMENTS=INFO
Environment=SEARCH_LOG_LEVEL_HUMAN_ORACLE=INFO
Environment=SEARCH_LOG_LEVEL_RETRIEVAL=INFO
Environment=SEARCH_LOG_LEVEL_RETRIEVAL_ANALYSIS=INFO
Environment=SEARCH_LOG_LEVEL_RETRIEVAL_RELEASE=INFO
Environment=SEARCH_LOG_LEVEL_STAGE_DIAGNOSIS=INFO
Environment=SEARCH_LOG_LEVEL_QUERY_CONSTRUCTOR=INFO
Environment=SEARCH_LOG_LEVEL_RANKING=OFF
ExecStart=/var/www/search-engine-eva-agent/.venv/bin/python -m uvicorn apps.api.main:app --host 127.0.0.1 --port 8010 --no-access-log
StandardOutput=journal
StandardError=journal
SyslogIdentifier=search-engine-eva-agent
Restart=on-failure
RestartSec=3
KillMode=control-group
SendSIGKILL=yes
TimeoutStopSec=10s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ReadOnlyPaths=/var/www/search-engine-eva-agent
ReadWritePaths=/var/lib/search-engine-eva-agent/runtime
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027

[Install]
WantedBy=multi-user.target

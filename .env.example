SEARCH_BACKEND=local
SEARCH_SAMPLE_PATH=data/samples/products.json
SEARCH_CATALOG_INDEX=data/index/catalog-baseline-v1.sqlite3
# Production keeps mutable Agent evidence outside the read-only source tree.
# The directory must already exist and be absolute when configured.
SEARCH_AGENT_ARTIFACT_ROOT=
# Production injects the verified, lowercase 40-character deployment commit.
# Local development leaves this empty and validates the clean Git worktree.
SEARCH_CODE_REVISION=
# Diagnostics go to stderr. Each module can be independently set to
# DEBUG/INFO/WARNING/ERROR/CRITICAL/OFF.
SEARCH_LOG_FORMAT=json
SEARCH_LOG_LEVEL=WARNING
SEARCH_LOG_LEVEL_API=INFO
SEARCH_LOG_LEVEL_BACKEND=WARNING
SEARCH_LOG_LEVEL_CATALOG=WARNING
SEARCH_LOG_LEVEL_AGENT_OPTIMIZATION=WARNING
SEARCH_LOG_LEVEL_DATA=WARNING
SEARCH_LOG_LEVEL_EVALUATION=WARNING
SEARCH_LOG_LEVEL_RANKING=OFF
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_INDEX=search-quality-smoke
OPENSEARCH_EXPECTED_CLUSTER=search-quality-local
OPENSEARCH_EXPECTED_VERSION=3.8.0
# Destructive reset is disabled by default; `make smoke-opensearch` enables it.
OPENSEARCH_ALLOW_INDEX_RESET=false
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
